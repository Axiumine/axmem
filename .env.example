# ============================================
# Axmem - Environment Configuration
# ============================================
# OPTIONAL: Copy this file to .env in the directory you start the server from and customize values.
# .env is git-ignored. If no .env file exists, the application uses defaults from app/config/settings.py.
# A user-level file at ~/.config/forgetful/.env (`forgetful auth login --server URL` saves FORGETFUL_SERVER there) outranks the local one.
# Every setting is documented in docs/configuration.md.
#
# Standard usage:
#   cp .env.example .env
#   # Edit .env with your custom values
#   uv run main.py

# Application Info
SERVICE_NAME=Forgetful
SERVICE_VERSION=v0.1.0
SERVICE_DESCRIPTION="Forgetful Service"

# Server Configuration
# 0.0.0.0 listens on all interfaces and needs a credential mode (AUTH_MODE=jwt, introspection or static);
# 127.0.0.1 accepts connections from this machine only and is the only bind AUTH_MODE=none allows.
SERVER_HOST=127.0.0.1
SERVER_PORT=8020
LOG_LEVEL=INFO
LOG_FORMAT=json # console or json

# CORS Configuration (HTTP transport only)
# Enable CORS for browser-based clients (e.g., forgetful-ui)
CORS_ENABLED=false
# Allowed origins (JSON array format). Use ["*"] to allow all origins.
CORS_ORIGINS=["http://localhost:3001"]

# Repository Config
# DATABASE options: 'Postgres' or 'SQLite'
# - Use Postgres for multi-user deployments (needs a PostgreSQL server with the pgvector extension)
# - Use SQLite for simple single-user setups (no server to run)
DATABASE=SQLite

# PostgreSQL Configuration (when DATABASE=Postgres)
POSTGRES_HOST=127.0.0.1
PGPORT=5099
POSTGRES_DB=forgetful
## CHANGE THESE ##
POSTGRES_USER=forgetful
POSTGRES_PASSWORD=forgetful
DB_LOGGING=false

# SQLite Configuration (when DATABASE=SQLite)
# Unset = forgetful.db in the platform user data directory (e.g. ~/.local/share/forgetful/forgetful.db).
# A relative path is relative to the directory the server is started from.
# SQLITE_PATH=data/forgetful.db
SQLITE_MEMORY=false  # Set to true for in-memory database (ephemeral)

# Backup Configuration (taken by `--re-embed`, both SQLite and Postgres)
# Empty = next to the SQLite database (the SQLITE_PATH directory).
# BACKUP_DIR=

# ============================================
# Authentication Configuration
# ============================================
# The server fails closed: with AUTH_MODE unset it refuses to start. Choose one mode:
#   none           no credential; every request is the tenant DEFAULT_TENANT.
#                  Accepted only on stdio or when SERVER_HOST is 127.0.0.1 or ::1.
#   jwt            signed bearer tokens (JWT)
#   introspection  opaque bearer tokens checked at an RFC 7662 endpoint
#   static         one fixed bearer token per tenant, configured as SHA-256 hashes
# With jwt and introspection the tenant is the token claim tenant_id, else tenant, else sub.
# See docs/configuration.md for the details.

# --- Option 1: No authentication, local use only ---
# Keep SERVER_HOST=127.0.0.1 (above) for HTTP; stdio needs no host.
AUTH_MODE=none
DEFAULT_TENANT=default

# --- Option 2: Static bearer tokens ---
# Only the hash of each token is configured, never the token. Generate one with:
#   TOKEN=$(openssl rand -hex 32); echo "$TOKEN"; printf '%s' "$TOKEN" | sha256sum | cut -d' ' -f1
# AUTH_MODE=static
# AUTH_STATIC_TOKEN_HASHES={"acme": "<64 hex characters>", "globex": "<64 hex characters>"}

# --- Option 3: Token introspection (OAuth 2.0 RFC 7662) ---
# AUTH_MODE=introspection
# FASTMCP_SERVER_AUTH_INTROSPECTION_URL=https://your-auth-server.com/oauth/introspect
# FASTMCP_SERVER_AUTH_INTROSPECTION_CLIENT_ID=your-client-id
# FASTMCP_SERVER_AUTH_INTROSPECTION_CLIENT_SECRET=your-client-secret
# FASTMCP_SERVER_AUTH_INTROSPECTION_REQUIRED_SCOPES=api:read,api:write

# --- Option 4: JWT verification ---
# AUTH_MODE=jwt
# FASTMCP_SERVER_AUTH_JWT_JWKS_URI=https://your-auth-server.com/.well-known/jwks.json
# FASTMCP_SERVER_AUTH_JWT_ISSUER=https://your-auth-server.com
# FASTMCP_SERVER_AUTH_JWT_AUDIENCE=your-api-audience
# FASTMCP_SERVER_AUTH_JWT_REQUIRED_SCOPES=api:read,api:write

# Memory Configuration
MEMORY_TITLE_MAX_LENGTH=200      # Must be "easily titled" - scannable
MEMORY_CONTENT_MAX_LENGTH=2000   # ~300-400 words - single concept
MEMORY_CONTEXT_MAX_LENGTH=500    # Brief contextual description
MEMORY_KEYWORDS_MAX_COUNT=10     # For semantic clustering
MEMORY_TAGS_MAX_COUNT=10         # For categorization
MEMORY_KEYWORD_MAX_LENGTH=100    # Characters per keyword
MEMORY_TAG_MAX_LENGTH=100        # Characters per tag
MEMORY_SOURCE_FILE_MAX_LENGTH=4096  # Characters per source file path
MEMORY_TOKEN_BUDGET=8000         # token budget for retrieved memories (to protect context window)
MEMORY_MAX_MEMORIES=20           # maximum number of memories that can be retrieved from a query
MEMORY_NUM_AUTO_LINK=3           # number of memories to automatically link (set to 0 to prevent auto linking)
MEMORY_SIMILARITY_THRESHOLD=0.7  # minimum cosine similarity for automatic links
# OBSOLETE_WARNING_ENABLED=true      # warn when creating memories similar to superseded ones
# OBSOLETE_WARNING_THRESHOLD=0.89   # minimum cosine similarity for obsolete memory warning

# Search Configuration
# FastEmbed (local) Embedding Provider Configuration
EMBEDDING_PROVIDER=FastEmbed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
# Set to true to require pre-cached FastEmbed models and fail fast instead of
# attempting HuggingFace/GCS downloads (applies to both the embedding model
# and the FastEmbed reranker). See docs/OFFLINE_SETUP.md.
FASTEMBED_LOCAL_FILES_ONLY=false
# Optional ONNX Runtime providers for the FastEmbed embedding model (empty = FastEmbed default).
# EMBEDDING_ONNX_PROVIDERS=DmlExecutionProvider,CPUExecutionProvider
# Per-request timeout in seconds for remote embedding providers (Azure, Google, OpenAI, Ollama).
# OpenAI/Azure clients retry twice, so one call can take up to three times this value.
# EMBEDDING_REQUEST_TIMEOUT_SECONDS=60

# Azure Embedding Provider Configuration - Only required if EMBEDDING_PROVIDER == Azure
# EMBEDDING_PROVIDER=Azure
# EMBEDDING_MODEL=text-embedding-3-large
# AZURE_ENDPOINT=https://<azure-resource-name>.openai.azure.com/
# AZURE_DEPLOYMENT=text-embedding-3-large
# AZURE_API_VERSION=2024-02-01
# AZURE_API_KEY=<AZURE API KEY>
# Set to false for deployments that reject the `dimensions` parameter (text-embedding-ada-002)
# AZURE_SUPPORTS_DIMENSIONS=true

# Google Embedding Provider Configuration - Only required if EMBEDDING_PROVIDER == Google
# EMBEDDING_PROVIDER=Google
# EMBEDDING_MODEL=models/gemini-embedding-001
# GOOGLE_AI_API_KEY=<Google AI Key>

# OpenAI Embedding Provider Configuration - Only required if EMBEDDING_PROVIDER == OpenAI
# EMBEDDING_PROVIDER=OpenAI
# OPENAI_API_KEY=<OpenAI API Key>
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# OpenAI-compatible endpoint (llama.cpp, vLLM, LiteLLM, etc.) - Uses EMBEDDING_PROVIDER=OpenAI
# EMBEDDING_PROVIDER=OpenAI
# OPENAI_BASE_URL=http://localhost:8080/v1
# EMBEDDING_MODEL=my-model
# OPENAI_SUPPORTS_DIMENSIONS=false
# EMBEDDING_DIMENSIONS=384

# Ollama Embedding Provider Configuration - Only required if EMBEDDING_PROVIDER == Ollama
# EMBEDDING_PROVIDER=Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# RERANKING CONFIGURATION
# FastEmbed (local) Reranking Configuration
RERANKING_ENABLED=true
RERANKING_PROVIDER=FastEmbed
RERANKING_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
# Local FastEmbed only; ignored by HTTP rerankers. Both must be positive integers.
RERANKING_THREADS=1  # Inference threading for the shared ONNX model
RERANKING_WORKERS=1  # Maximum concurrent local reranking jobs (not a queue limit)
# Multi-core starting point to benchmark: RERANKING_THREADS=4, RERANKING_WORKERS=2
# Restart after changing these values; more concurrency is not always faster.
# Local FastEmbed only. Comma-separated ONNX Runtime providers, empty = FastEmbed default.
# Every listed provider must be installed (e.g. onnxruntime-directml for DmlExecutionProvider).
# DmlExecutionProvider requires RERANKING_WORKERS=1.
# RERANKING_ONNX_PROVIDERS=DmlExecutionProvider,CPUExecutionProvider
DENSE_SEARCH_CANDIDATES=20

# HTTP Reranking Configuration (Jina, Cohere, vLLM, llama.cpp, Infinity, etc.)
# RERANKING_PROVIDER=HTTP
# RERANKING_MODEL=jina-reranker-v2-base-multilingual
# RERANKING_URL=https://api.jina.ai/v1/rerank
# RERANKING_API_KEY=<API Key>
# Seconds an HTTP rerank request may take before the search fails (default 60).
# RERANKING_TIMEOUT=60
#
# For Cohere: RERANKING_URL=https://api.cohere.com/v2/rerank
# For local llama.cpp: RERANKING_URL=http://localhost:8012/v1/rerank (no API key needed)
# For local vLLM: RERANKING_URL=http://localhost:8000/v1/rerank

# Provenance Tracking Defaults
# When set, these values are automatically applied to all create operations
# for objects that don't already have provenance fields provided.
# ENCODING_AGENT=          # Software running the agent (e.g., "OpenCode", "Claude Code")
# ENCODING_VERSION=        # Version of that software (e.g., "1.3.13")
# AGENT_ID=                # Agent identity (e.g., "CodeAgentUltra")
# AGENT_VERSION=           # Agent version (e.g., "1.0")
# AGENT_MODEL=             # LLM model (e.g., "claude-sonnet-4-6")
# ENFORCE_ENV_OVERWRITE=false  # When true, env values override agent-provided provenance on all writes

# CLI Remote Mode Configuration
# Default remote deployment URL for the forgetful CLI (empty = local mode).
# Usually written by `forgetful auth login --server URL` into ~/.config/forgetful/.env;
# only set here to make the CLI target another deployment by default.
# FORGETFUL_SERVER=https://forgetful.example.com/mcp

# ============================================
# Developer secrets for the quality gates
# ============================================
# Only needed by contributors; the application ignores this key.
# Qodana Ultimate Plus token, used by `python -m scripts.quality gate qodana` (pre-push, CI).
# Leave it commented out until you have a token: an empty value counts as set.
# QODANA_TOKEN=
