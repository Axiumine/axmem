#!/bin/sh
# Local denylist guard (see docs/quality-gates.md).
# Refuses staged changes, commit messages and pushes that contain a term listed in
# .git/info/denylist: one extended regular expression per line, matched case-insensitively.
# The file belongs to the clone and is never tracked, so no tracked file names the terms.
# Without the file, or with an empty one, nothing is checked. The terms are never printed.
# A guard that cannot do its job must not let everything through, so it stops with status 2 when anything it relies on
# fails: a path that grep cannot read as the list, a line of the list that is not a valid expression, or a git, grep or
# awk call that fails (a missing tool included). Every such call is captured on its own, because the status of a
# pipeline is the status of its last stage and would hide the failure of an earlier one.
#   denylist-check staged            the staged file names and added lines
#   denylist-check message <file>    a commit message file
#   denylist-check range <tip>       every commit reachable from <tip> that no remote-tracking ref has
list=$(git rev-parse --git-path info/denylist 2>/dev/null) || exit 0
[ -e "$list" ] || [ -h "$list" ] || exit 0

refuse() {
    echo "[denylist] $1 contains a term from $list; remove it (the terms are not shown)" >&2
    exit 1
}
stop() {
    echo "[denylist] cannot check: $1 (the terms are not shown)" >&2
    exit 2
}
# Added lines of a diff on stdin, without the "+" column. The state machine (file header, then hunks) is what keeps
# an added line that itself begins with "++" from being taken for a "+++ b/path" file header and dropped. A combined
# diff of a merge has one column per parent (the number of leading "@" minus one); a line is added if any column has "+".
added_lines() {
    awk '
        /^diff / { hunk = 0; next }
        /^@@/ { match($0, /^@+/); columns = RLENGTH - 1; hunk = 1; next }
        hunk && substr($0, 1, columns) ~ /\+/ { print substr($0, columns + 1) }
    '
}
# Numbers of the lines of the list that are not valid extended regular expressions (never the lines themselves). Each
# line is checked alone: validity of the whole list says nothing about its lines, since two invalid neighbours (a term
# that ends in a backslash, an unbalanced bracket) can join into a valid expression with another meaning.
invalid_line_numbers() {
    number=0
    while IFS= read -r term || [ -n "$term" ]; do
        number=$((number + 1))
        printf '' | grep -q -E -e "$term" 2>/dev/null
        [ $? -le 1 ] || printf ' %s' "$number"
    done < "$list"
}

# The non-blank lines of the list, which grep takes as one pattern each (POSIX): a line is compiled on its own and keeps
# its own back-reference groups, instead of being joined to its neighbours with "|". grep answers 1 when no line is left.
patterns=$(grep -v '^[[:space:]]*$' "$list" 2>/dev/null)
[ $? -le 1 ] || stop "grep cannot read $list"
[ -n "$patterns" ] || exit 0
numbers=$(invalid_line_numbers)
[ -z "$numbers" ] || stop "not valid extended regular expressions, by line number in $list:$numbers"

# scan <what> <text>: the text must not match the list. grep answers 0 for a match, 1 for none and 2 (or more) when it
# could not run; that last case stops the check. Its own message is dropped, since some implementations quote the expression.
scan() {
    printf '%s' "$2" | grep -q -i -E -e "$patterns" 2>/dev/null
    status=$?
    case $status in
        0) refuse "$1" ;;
        1) ;;
        *) stop "grep failed with status $status while checking $1" ;;
    esac
}
# scan_diff <what> <diff>: the lines the diff adds must not match the list.
scan_diff() {
    added=$(printf '%s' "$2" | added_lines) || stop "awk failed while reading the lines added by $1"
    scan "$1" "$added"
}

case "$1" in
    staged)
        names=$(git diff --cached --name-only) || stop "git failed to list the staged file names"
        scan "a staged file name" "$names"
        patch=$(git diff --cached -U0 --no-color) || stop "git failed to read the staged changes"
        scan_diff "the staged changes" "$patch"
        ;;
    message)
        [ -r "$2" ] || { echo "[denylist] cannot read the commit message file '$2'" >&2; exit 2; }
        text=$(grep -v '^#' "$2")
        [ $? -le 1 ] || stop "grep failed to read the commit message file"
        scan "the commit message" "$text"
        ;;
    range)
        commits=$(git rev-list "$2" --not --remotes) || stop "git failed to list the unpushed commits"
        for commit in $commits; do
            body=$(git log -1 --format=%B "$commit") || stop "git failed to read the message of commit $commit"
            scan "the message of commit $commit" "$body"
            patch=$(git show --format= -U0 --no-color "$commit") || stop "git failed to read commit $commit"
            scan_diff "commit $commit" "$patch"
        done
        ;;
    *)
        echo "usage: denylist-check staged | message <file> | range <tip>" >&2
        exit 2
        ;;
esac
exit 0
