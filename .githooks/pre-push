#!/bin/sh
# The one place that runs the GPU, Docker and Qdrant gates (hosted CI has none of them): static gates and trivy, types,
# the architecture, integration and end-to-end suites with 100% coverage, the Qdrant cluster suite, memory budgets,
# Qodana, mutation testing of the app/ modules the push changes (the slowest gate, limited to 24 hours; MUTATION_TIMEOUT_S changes the cap),
# GitNexus. A failing gate, a machine without an NVIDIA GPU or a Docker daemon, and a tool that is missing all
# refuse the push; bypass a gate on purpose with  SKIP=qodana,trivy git push ...   (see docs/quality-gates.md)
#
# The gates check the working tree, so they only prove the commit being pushed when it is the checked-out HEAD. A push
# of any other commit (for example `git push origin fix/some-branch` from another branch) is refused instead of passing
# unchecked: check that branch out and push it, or run `uv run python -m scripts.quality stage pre-push` yourself.
# Deleting a remote ref has nothing to check and goes through.
cd "$(git rev-parse --show-toplevel)" || exit 1
head_sha=$(git rev-parse HEAD) || exit 1
gate=0
unchecked=""
while read -r local_ref local_sha _remote_ref _remote_sha; do
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac
    .githooks/denylist-check range "$local_sha" || exit 1
    pushed_sha=$(git rev-parse --verify --quiet "$local_sha^{commit}") || pushed_sha=""
    if [ "$pushed_sha" = "$head_sha" ]; then
        gate=1
    else
        unchecked="$unchecked $local_ref"
    fi
done
if [ -n "$unchecked" ]; then
    echo "[pre-push] refused:$unchecked is not the checked-out HEAD, and the gates check the working tree." >&2
    echo "[pre-push] check it out and push it from there (the pipeline then runs for it)." >&2
    exit 1
fi
if [ "$gate" -eq 0 ]; then
    exit 0
fi
# the remote lets a branch without an upstream be compared with that remote's main, not with the old origin/main
export QUALITY_PUSH_REMOTE="$1"
exec uv run --frozen python -m scripts.quality stage pre-push
